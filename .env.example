# Copy to .env to override the local defaults in docker-compose.yml and the
# API's dev profile. Compose and the API both work without a .env file; this
# file only documents the variables and overrides them. Never put real secrets
# here — .env is git-ignored, .env.example is committed.

# Database (used by both docker-compose.yml and the API dev profile)
POSTGRES_DB=moneymacros
POSTGRES_USER=moneymacros
POSTGRES_PASSWORD=moneymacros

# Where the API reaches the database (dev profile).
# If port 5432 is already taken on your machine (e.g. a locally installed
# PostgreSQL service), copy this file to .env and set DB_PORT to a free port
# such as 5433 — it applies to both docker-compose.yml and the API.
DB_HOST=localhost
DB_PORT=5432
